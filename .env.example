# Text planning and writing (OpenAI-compatible endpoint)
CONTENT_API_KEY=
CONTENT_API_URL=https://api.apimart.ai/v1/chat/completions
CONTENT_MODEL=gpt-5.4

# Image generation
APIMART_API_KEY=
APIMART_API_BASE=https://api.apimart.ai
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_OFFICIAL_FALLBACK=false
APIMART_CONCURRENCY=3

# WeChat Official Account: use access token OR AppID/AppSecret
WECHAT_ACCESS_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
